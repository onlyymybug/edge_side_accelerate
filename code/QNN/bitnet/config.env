# Host-side ADB configuration.
ANDROID_SERIAL="${ANDROID_SERIAL:-3B15B800A0R00000}"
ADB_BIN="${ADB_BIN:-adb}"

# This directory contains the copied experiment scripts; model artifacts remain
# in the original BitNet bundle instead of being duplicated under pace/code.
BITNET_CODE_ROOT="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ARTIFACT_ROOT="${ARTIFACT_ROOT:-${BITNET_CODE_ROOT}/../../../../bitnet_qnn_artifacts_hybrid_1024}"
BUNDLE_ROOT="${ARTIFACT_ROOT}"
RUNTIME_BUNDLE_ROOT="${RUNTIME_BUNDLE_ROOT:-${BITNET_CODE_ROOT}/../../../../bitnet_qnn228_htp_mode_phone_bundle}"
BITNET_RAW_PROMPT_RUNNER_PATH="${BITNET_RAW_PROMPT_RUNNER_PATH:-${BITNET_CODE_ROOT}/../../../../bitnet_qnn228_raw_prompt_runner/qnn_llama_runner_raw_prompt}"

# Existing BitNet runtime environment on the phone.
DEVICE_DIR="${DEVICE_DIR:-/data/local/tmp/lyy/executorch/single_llama}"
REMOTE_MODEL_NAME="${REMOTE_MODEL_NAME:-hybrid_llama_qnn_1024.pte}"
REMOTE_QUANT_ATTRS_NAME="${REMOTE_QUANT_ATTRS_NAME:-hybrid_llama_qnn_1024_quant_attrs.txt}"

# The Hybrid-1024 PTE remains under ARTIFACT_ROOT.  Runtime binaries and the
# matching tokenizer come from the QNN 2.28 runtime-HTP-mode bundle.
PACE_ROOT="${PACE_ROOT:-${BITNET_CODE_ROOT}/../../..}"
DEVICE_LABEL="${DEVICE_LABEL:-oneplus}"
MODEL_RESULT_NAME="${MODEL_RESULT_NAME:-bitnet-2b}"
QUANTIZATION_RESULT_NAME="${QUANTIZATION_RESULT_NAME:-w4a16}"
RESULT_MODEL_DIR_NAME="${RESULT_MODEL_DIR_NAME:-bitnet-2B-w4a16}"
BITNET_PERFORMANCE_MODE="${BITNET_PERFORMANCE_MODE:-burst}"
case "${BITNET_PERFORMANCE_MODE}" in
  burst)     BITNET_HTP_PERFORMANCE_MODE=2 ;;
  balanced)  BITNET_HTP_PERFORMANCE_MODE=8 ;;
  low_power) BITNET_HTP_PERFORMANCE_MODE=5 ;;
  *)
    echo "BITNET_PERFORMANCE_MODE must be burst, balanced, or low_power" >&2
    return 2
    ;;
esac
# Always overwrite generic HTP variables here.  pace/code/QNN/scripts/_env.sh also
# defines them for Qwen, and BitNet must not accidentally inherit Qwen's mode.
HTP_PERFORMANCE_MODE="${BITNET_HTP_PERFORMANCE_MODE}"
HTP_PERFORMANCE_MODE_NAME="${BITNET_PERFORMANCE_MODE}_runtime_override"
PERFORMANCE_MODE_RESULT_NAME="${BITNET_PERFORMANCE_MODE}"
QNN_RUNNER_NAME="qnn_llama_runner_raw_prompt"
QNN_RUNNER_LOCAL_PATH="${BITNET_RAW_PROMPT_RUNNER_PATH}"
QNN_RUNNER_REMOTE_PATH="${DEVICE_DIR}/${QNN_RUNNER_NAME}"
BITNET_RAW_PROMPT=1
BITNET_PROMPT_TEMPLATE_VERSION="bitnet_native_raw_v1"
RESULTS_ROOT="${BITNET_RESULTS_ROOT:-${PACE_ROOT}/results/QNN/${DEVICE_LABEL}}"
GSM8K_DATASET_PATH="${GSM8K_DATASET_PATH:-${PACE_ROOT}/datasets/gsm8k_test.jsonl}"
MATH500_DATASET_PATH="${MATH500_DATASET_PATH:-${PACE_ROOT}/datasets/math500_test.jsonl}"
TOKENIZER_PATH="${TOKENIZER_PATH:-${RUNTIME_BUNDLE_ROOT}/model/tokenizer.json}"
PYTHON_BIN="${PYTHON_BIN:-/home/lyyyy/miniconda3/envs/pace-export/bin/python}"

# Parameters embedded in the Hybrid-1024 PTE.
MAX_SEQ_LEN="${MAX_SEQ_LEN:-1024}"
PREFILL_AR_LEN="${PREFILL_AR_LEN:-32}"
GSM8K_TARGET_OUTPUT_TOKENS="${GSM8K_TARGET_OUTPUT_TOKENS:-128}"
MATH500_TARGET_OUTPUT_TOKENS="${MATH500_TARGET_OUTPUT_TOKENS:-256}"
TELEMETRY_INTERVAL_SECONDS="${TELEMETRY_INTERVAL_SECONDS:-0.5}"
DEADLINES_MS="${DEADLINES_MS:-5000,10000,20000,30000}"
# The raw-prompt runner consumes exactly the host-rendered native prompt. The
# only extra slot is the runner's sequence terminator reservation.
BITNET_SEQ_LEN_COMPENSATION="${BITNET_SEQ_LEN_COMPENSATION:-1}"
EVAL_MODE="${EVAL_MODE:-1}"
KV_UPDATER="${KV_UPDATER:-ShiftPointer}"
TEMPERATURE="${TEMPERATURE:-0}"
LOGITS_SCALE="${LOGITS_SCALE:-0.0012398984981700778}"
LOGITS_OFFSET="${LOGITS_OFFSET:-32310}"
