# Shared host/device configuration for the Android T-MAC experiments.
PACE_ROOT="${PACE_ROOT:-/home/lyyyy/pace}"
TMAC_RESULTS_ROOT="${TMAC_RESULTS_ROOT:-${PACE_ROOT}/results/T-MAC}"
ADB_BIN="${ADB_BIN:-adb}"
ADB_SERVER_PORT="${ADB_SERVER_PORT:-5037}"
ANDROID_SERIAL="${ANDROID_SERIAL:-}"
DEVICE_LABEL="${DEVICE_LABEL:-redmi}"
ONEPLUS_HW_SERIAL="${ONEPLUS_HW_SERIAL:-3B15B800A0R00000}"
REDMI_HW_SERIAL="${REDMI_HW_SERIAL:-189f0fad}"
TMAC_PHONE_DIR="${TMAC_PHONE_DIR:-/data/local/tmp/qwen25_3b_tmac_android_bundle}"
TMAC_TOKENIZER_PATH="${TMAC_TOKENIZER_PATH:-/home/lyyyy/qwen25_3b_phone_bundle/model/tokenizer.json}"
TMAC_THREADS="${TMAC_THREADS:-4}"
MAX_SEQ_LEN="${MAX_SEQ_LEN:-1024}"
TELEMETRY_INTERVAL_SECONDS="${TELEMETRY_INTERVAL_SECONDS:-0.5}"
TMAC_RUNNER_MAX_SECONDS="${TMAC_RUNNER_MAX_SECONDS:-1800}"
PYTHON_BIN="${PYTHON_BIN:-/home/lyyyy/miniconda3/envs/pace/bin/python}"
BFCL_PYTHON="${BFCL_PYTHON:-/home/lyyyy/miniconda3/envs/bfcl-phone/bin/python}"
BFCL_ROOT="${BFCL_ROOT:-/home/lyyyy/gorilla/berkeley-function-call-leaderboard}"
RESULT_MODEL_DIR_NAME="${RESULT_MODEL_DIR_NAME:-qwen2.5-3B-tmac-w4a16}"
TMAC_CONFIGURATION_NAME="${TMAC_CONFIGURATION_NAME:-threads_${TMAC_THREADS}}"
GSM8K_BUDGET="${GSM8K_BUDGET:-512}"
MATH500_BUDGET="${MATH500_BUDGET:-512}"
HAMMERBENCH_DATASET_ROOT="${HAMMERBENCH_DATASET_ROOT:-/home/lyyyy/HammerBench/en_mod20_eq0}"

# Resolve the current ADB transport from the phone's stable hardware serial.
# This makes the same command work for USB and for Wi-Fi ADB after an IP change.
# If both transports for one phone are online, prefer USB (whose ADB serial is
# the hardware serial itself).  An explicit ANDROID_SERIAL always wins.
resolve_serial_by_hwserial() {
  local target="$1" serial hw attempt
  local serials
  serials="$("${ADB_BIN}" -P "${ADB_SERVER_PORT}" devices | awk 'NR > 1 && $2 == "device" { print $1 }')"

  for serial in ${serials}; do
    if [[ "${serial}" == "${target}" ]]; then
      printf '%s\n' "${serial}"
      return 0
    fi
  done

  for serial in ${serials}; do
    hw=""
    for attempt in 1 2 3; do
      hw="$("${ADB_BIN}" -P "${ADB_SERVER_PORT}" -s "${serial}" shell getprop ro.serialno 2>/dev/null | tr -d '\r')"
      [[ -n "${hw}" ]] && break
      sleep 0.5
    done
    if [[ "${hw}" == "${target}" ]]; then
      printf '%s\n' "${serial}"
      return 0
    fi
  done
  return 1
}

if [[ -z "${ANDROID_SERIAL}" ]]; then
  case "${DEVICE_LABEL}" in
    redmi) target_hw_serial="${TMAC_HW_SERIAL:-${REDMI_HW_SERIAL}}" ;;
    oneplus) target_hw_serial="${TMAC_HW_SERIAL:-${ONEPLUS_HW_SERIAL}}" ;;
    *)
      echo "Unknown DEVICE_LABEL=${DEVICE_LABEL}; set ANDROID_SERIAL or TMAC_HW_SERIAL explicitly." >&2
      return 2
      ;;
  esac
  ANDROID_SERIAL="$(resolve_serial_by_hwserial "${target_hw_serial}" || true)"
  if [[ -z "${ANDROID_SERIAL}" ]]; then
    echo "No online ${DEVICE_LABEL} device found (ro.serialno=${target_hw_serial})." >&2
    echo "Connect it through USB/Wi-Fi ADB, or set ANDROID_SERIAL explicitly." >&2
    return 2
  fi
fi

export PACE_ROOT TMAC_RESULTS_ROOT ADB_BIN ADB_SERVER_PORT ANDROID_SERIAL DEVICE_LABEL
export ONEPLUS_HW_SERIAL REDMI_HW_SERIAL
export TMAC_PHONE_DIR TMAC_TOKENIZER_PATH TMAC_THREADS MAX_SEQ_LEN
export TELEMETRY_INTERVAL_SECONDS TMAC_RUNNER_MAX_SECONDS PYTHON_BIN
export BFCL_PYTHON BFCL_ROOT RESULT_MODEL_DIR_NAME TMAC_CONFIGURATION_NAME
export GSM8K_BUDGET MATH500_BUDGET HAMMERBENCH_DATASET_ROOT
unset ADB_SERVER_SOCKET
